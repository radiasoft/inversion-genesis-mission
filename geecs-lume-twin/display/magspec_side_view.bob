<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>MagSpec side screen</name>
  <width>920</width>
  <height>420</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>MagSpec SIDE screen (low energy) — 720 x 25.5 mm; overview at 2x vertical stretch. 0 = magnet center; momentum rises toward +s.</text>
    <x>10</x><y>5</y><width>900</width><height>24</height>
    <font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font>
  </widget>
  <widget type="image" version="2.0.0">
    <name>Image</name>
    <pv_name>pva://HTU:SIM:MagSpec_SideScreen_image</pv_name>
    <x>10</x><y>35</y><width>880</width><height>92</height>
    <autoscale>true</autoscale>
    <x_axis>
      <visible>true</visible>
      <minimum>-360</minimum>
      <maximum>360</maximum>
      <title>s [mm]</title>
    </x_axis>
    <y_axis>
      <visible>true</visible>
      <minimum>-12.75</minimum>
      <maximum>12.75</maximum>
      <title>y [mm]</title>
    </y_axis>
  </widget>
  <widget type="label" version="2.0.0">
    <name>ZoomTitle</name>
    <text>Auto-tracking zoom: +/-50 mm window recentered on the beam. Window center [mm]:</text>
    <x>10</x><y>145</y><width>560</width><height>22</height>
    <font><font family="Liberation Sans" style="BOLD" size="12.0"/></font>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>ZoomCenter</name>
    <pv_name>pva://HTU:SIM:MagSpec_SideZoom_Center_mm</pv_name>
    <x>575</x><y>145</y><width>90</width><height>22</height>
    <font><font family="Liberation Sans" style="BOLD" size="12.0"/></font>
  </widget>
  <widget type="image" version="2.0.0">
    <name>ZoomImage</name>
    <pv_name>pva://HTU:SIM:MagSpec_SideZoom_image</pv_name>
    <x>10</x><y>175</y><width>880</width><height>225</height>
    <autoscale>true</autoscale>
    <x_axis>
      <visible>true</visible>
      <minimum>-50</minimum>
      <maximum>50</maximum>
      <title>s - window center [mm]</title>
    </x_axis>
    <y_axis>
      <visible>true</visible>
      <minimum>-12.75</minimum>
      <maximum>12.75</maximum>
      <title>y [mm]</title>
    </y_axis>
  </widget>
</display>
