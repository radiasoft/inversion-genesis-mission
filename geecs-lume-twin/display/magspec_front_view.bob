<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>MagSpec front screen</name>
  <width>920</width>
  <height>200</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>MagSpec FRONT screen (high energy) — 180 x 25.6 mm, true aspect. 0 = beam axis; momentum rises toward 0.</text>
    <x>10</x><y>5</y><width>900</width><height>24</height>
    <font><font family="Liberation Sans" style="BOLD" size="12.0"/></font>
  </widget>
  <widget type="image" version="2.0.0">
    <name>Image</name>
    <pv_name>pva://HTU:SIM:MagSpec_FrontScreen_image</pv_name>
    <x>10</x><y>40</y><width>880</width><height>125</height>
    <autoscale>true</autoscale>
    <x_axis>
      <visible>true</visible>
      <minimum>0</minimum>
      <maximum>180</maximum>
      <title>s [mm]</title>
    </x_axis>
    <y_axis>
      <visible>true</visible>
      <minimum>-12.8</minimum>
      <maximum>12.8</maximum>
      <title>y [mm]</title>
    </y_axis>
  </widget>
</display>
